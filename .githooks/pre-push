#!/usr/bin/env bash
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
HEAD_SHA="$(git -C "$ROOT" rev-parse HEAD)"

PUSH_COUNT=0
while read -r local_ref local_sha remote_ref remote_sha; do
	[[ -z "${local_sha:-}" ]] && continue
	# Deleting a remote ref pushes no objects.
	if [[ "$local_sha" =~ ^0+$ ]]; then
		continue
	fi
	PUSH_COUNT=$((PUSH_COUNT + 1))
	PEELED_SHA="$(git -C "$ROOT" rev-parse --verify --quiet "${local_sha}^{commit}" || true)"
	if [[ -z "$PEELED_SHA" ]]; then
		printf 'pre-push: outgoing ref %s (%s) does not resolve to a commit object; refusing push.\n' \
			"$local_ref" "$local_sha" >&2
		exit 1
	fi
	if [[ "$PEELED_SHA" != "$HEAD_SHA" ]]; then
		printf 'pre-push: outgoing ref %s (%s -> commit %s) does not match checked-out HEAD (%s); check out the exact commit before pushing so ./check verifies what is pushed.\n' \
			"$local_ref" "$local_sha" "$PEELED_SHA" "$HEAD_SHA" >&2
		exit 1
	fi
done

if [[ "$PUSH_COUNT" -eq 0 ]]; then
	exit 0
fi

if [[ -n "$(git -C "$ROOT" status --porcelain)" ]]; then
	printf 'pre-push: working tree or index has uncommitted/untracked changes; commit, stash, or clean before pushing so ./check verifies the exact pushed tree (%s).\n' \
		"$HEAD_SHA" >&2
	git -C "$ROOT" status --short >&2
	exit 1
fi

exec "$ROOT/check" --git-rev "$HEAD_SHA"
