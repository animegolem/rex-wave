#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<'EOF'
Usage: ./check [--lint-only] [--skip-clippy] [--with-tlc] [--git-rev <rev>] [-h|--help]

Runs the deterministic hermetic commit and CI verification pipeline:
  Stage 1 (parallel): cargo fmt, repo hygiene lints, bb-plugin tsc + node --test
  Stage 2 (compile):  cargo clippy (unless --skip-clippy), single-pass cargo test --no-run
  Stage 3 (parallel): compiled test binaries, rex-wave tui --self-test, schema --bb diff

Flags:
  --lint-only       Run Stage 1 + cargo clippy only, then exit 0.
  --skip-clippy     Skip cargo clippy in Stage 2 (used when lint job already ran).
  --with-tlc        Also run ./scripts/model-check.sh (44 TLC formal checks across specs/).
  --git-rev <rev>   Scan exact Git tree <rev> objects in Stage 1 repo hygiene.
  -h, --help        Show this help message.
EOF
}

LINT_ONLY=0
SKIP_CLIPPY=0
WITH_TLC=0
GIT_REV=""

while [[ $# -gt 0 ]]; do
	case "$1" in
	--lint-only)
		LINT_ONLY=1
		shift
		;;
	--skip-clippy)
		SKIP_CLIPPY=1
		shift
		;;
	--with-tlc)
		WITH_TLC=1
		shift
		;;
	--git-rev)
		if [[ $# -lt 2 || -z "$2" ]]; then
			printf 'error: --git-rev requires a commit/tree revision\n' >&2
			exit 2
		fi
		GIT_REV="$2"
		shift 2
		;;
	-h|--help)
		usage
		exit 0
		;;
	*)
		printf 'error: unknown option: %s\n' "$1" >&2
		usage >&2
		exit 2
		;;
	esac
done

