# Resolve node/npm across PATH, /opt/homebrew/bin, and /usr/local/bin.
find_tool() {
	local name="$1"
	local found
	if found="$(command -v "$name" 2>/dev/null)"; then
		printf '%s\n' "$found"
		return 0
	fi
	local candidate
	for candidate in "/opt/homebrew/bin/$name" "/usr/local/bin/$name"; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

NODE_BIN=""
if NODE_BIN="$(find_tool node)"; then
	NODE_DIR="$(dirname "$NODE_BIN")"
	case ":$PATH:" in
	*":$NODE_DIR:"*) ;;
	*) export PATH="$NODE_DIR:$PATH" ;;
	esac
fi

NPM_BIN=""
if NPM_BIN="$(find_tool npm)"; then
	NPM_DIR="$(dirname "$NPM_BIN")"
	case ":$PATH:" in
	*":$NPM_DIR:"*) ;;
	*) export PATH="$NPM_DIR:$PATH" ;;
	esac
fi

run_node() {
	if [[ -n "$NODE_BIN" ]]; then
		"$NODE_BIN" "$@"
	elif [[ -x "/Applications/bb.app/Contents/MacOS/bb" ]]; then
		ELECTRON_RUN_AS_NODE=1 /Applications/bb.app/Contents/MacOS/bb "$@"
	else
		printf 'error: node (>=22.18) or /Applications/bb.app is required for bb-plugin checks\n' >&2
		return 1
	fi
}

run_npm() {
	if [[ -n "$NPM_BIN" ]]; then
		"$NPM_BIN" "$@"
	else
		printf 'error: npm is required to populate the bb-plugin dependency cache\n' >&2
		return 1
	fi
}

