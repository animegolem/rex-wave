run_stage1_bb_plugin() {
	local pkg_file="$ROOT/bb-plugin/package.json"
	local lock_file="$ROOT/bb-plugin/package-lock.json"
	if [[ ! -f "$pkg_file" || ! -f "$lock_file" ]]; then
		printf 'error: missing bb-plugin/package.json or bb-plugin/package-lock.json\n' >&2
		return 1
	fi

	local lock_sha cache_dir cached_nm stage_dir
	lock_sha="$(sha256_files "$pkg_file" "$lock_file")"
	cache_dir="$CACHE_ROOT/$lock_sha"
	cached_nm="$cache_dir/node_modules"

	if [[ ! -f "$cached_nm/typescript/bin/tsc" ]]; then
		mkdir -p "$CACHE_ROOT"
		stage_dir="$(mktemp -d "$CACHE_ROOT/.install.${lock_sha}.XXXXXX")"
		cp "$pkg_file" "$lock_file" "$stage_dir/"
		if ! (cd "$stage_dir" && run_npm ci --ignore-scripts --no-audit --no-fund); then
			rm -rf "$stage_dir"
			return 1
		fi
		if [[ ! -f "$stage_dir/node_modules/typescript/bin/tsc" ]]; then
			rm -rf "$stage_dir"
			printf 'error: npm ci succeeded without typescript/bin/tsc\n' >&2
			return 1
		fi
		python3 - "$stage_dir" "$cache_dir" <<'PY' || return 1
import os, shutil, sys
stage_dir, cache_dir = sys.argv[1], sys.argv[2]
tsc_rel = os.path.join("node_modules", "typescript", "bin", "tsc")
try:
    os.rename(stage_dir, cache_dir)
except OSError:
    shutil.rmtree(stage_dir, ignore_errors=True)
    if not os.path.isfile(os.path.join(cache_dir, tsc_rel)):
        sys.stderr.write("error: failed to publish bb-plugin cache at {}\n".format(cache_dir))
        sys.exit(1)
PY
	fi

	local work_bb="$CHECK_TMP/bb-plugin"
	mkdir -p "$work_bb"
	cp \
		"$ROOT/bb-plugin/package.json" \
		"$ROOT/bb-plugin/package-lock.json" \
		"$ROOT/bb-plugin/tsconfig.json" \
		"$ROOT/bb-plugin/server.ts" \
		"$ROOT/bb-plugin/protocol.ts" \
		"$ROOT/bb-plugin/protocol.test.ts" \
		"$ROOT/bb-plugin/protocol.fixtures.json" \
		"$ROOT/bb-plugin/tools.generated.json" \
		"$work_bb/"
	ln -s "$cached_nm" "$work_bb/node_modules"

	(
		cd "$work_bb"
		run_node "$work_bb/node_modules/typescript/bin/tsc" -p "$work_bb/tsconfig.json" --noEmit
		run_node --test protocol.test.ts
	)
}

