def scrub_rust_noncode(text):
    out = []
    n = len(text)
    i = 0
    while i < n:
        c = text[i]
        if c == "/" and i + 1 < n and text[i + 1] == "/":
            while i < n and text[i] != "\n":
                out.append(" ")
                i += 1
            continue
        if c == "/" and i + 1 < n and text[i + 1] == "*":
            depth = 1
            out.extend((" ", " "))
            i += 2
            while i < n and depth > 0:
                if text[i] == "/" and i + 1 < n and text[i + 1] == "*":
                    depth += 1
                    out.extend((" ", " "))
                    i += 2
                elif text[i] == "*" and i + 1 < n and text[i + 1] == "/":
                    depth -= 1
                    out.extend((" ", " "))
                    i += 2
                else:
                    out.append("\n" if text[i] == "\n" else " ")
                    i += 1
            continue
        if c in ("r", "b") and (i == 0 or not (text[i - 1].isalnum() or text[i - 1] == "_")):
            j = i + 1
            is_raw = c == "r"
            if c == "b" and j < n and text[j] == "r":
                is_raw = True
                j += 1
            if is_raw:
                hashes = 0
                while j < n and text[j] == "#":
                    hashes += 1
                    j += 1
                if j < n and text[j] == '"':
                    while i <= j:
                        out.append(" ")
                        i += 1
                    closer = '"' + ("#" * hashes)
                    end_pos = text.find(closer, i)
                    if end_pos == -1:
                        end_pos = n
                    else:
                        end_pos += len(closer)
                    while i < end_pos:
                        out.append("\n" if text[i] == "\n" else " ")
                        i += 1
                    continue
        if c == '"':
            out.append(" ")
            i += 1
            while i < n:
                ch = text[i]
                if ch == "\\":
                    out.append(" ")
                    i += 1
                    if i < n:
                        out.append("\n" if text[i] == "\n" else " ")
                        i += 1
                    continue
                out.append("\n" if ch == "\n" else " ")
                i += 1
                if ch == '"':
                    break
            continue
        if c == "'":
            if i + 2 < n and text[i + 1] == "\\":
                end_q = text.find("'", i + 2, min(n, i + 12))
                if end_q != -1:
                    while i <= end_q:
                        out.append(" ")
                        i += 1
                    continue
            elif i + 2 < n and text[i + 2] == "'" and text[i + 1] != "\n":
                out.extend((" ", " ", " "))
                i += 3
                continue
        out.append(c)
        i += 1
    return "".join(out)

def balanced_end(text, start, open_ch, close_ch):
    depth = 1
    i = start
    limit = min(len(text), start + MAX_MACRO_SCAN)
    while i < limit:
        c = text[i]
        if c == open_ch:
            depth += 1
        elif c == close_ch:
            depth -= 1
            if depth == 0:
                return i
        i += 1
    return limit

def line_of(text, offset):
    return text.count("\n", 0, offset) + 1

def select_branch_future_spans(text, body_start, body_end):
    """Yield (start, end) slices for each top-level select! branch future (before `=>`),
    skipping handler expressions that run after a branch is selected."""
    spans = []
    i = body_start
    arm_start = body_start
    depth_brace = 0
    depth_paren = 0
    depth_bracket = 0
    in_handler = False
    handler_is_block = False
    while i < body_end:
        c = text[i]
        if c == "{":
            depth_brace += 1
        elif c == "}":
            if depth_brace > 0:
                depth_brace -= 1
                if (
                    in_handler
                    and handler_is_block
                    and depth_brace == 0
                    and depth_paren == 0
                    and depth_bracket == 0
                ):
                    in_handler = False
                    handler_is_block = False
                    j = i + 1
                    while j < body_end and text[j] in (" ", "\t", "\r", "\n", ","):
                        j += 1
                    arm_start = j
                    i = j
                    continue
        elif c == "(":
            depth_paren += 1
        elif c == ")" and depth_paren > 0:
            depth_paren -= 1
        elif c == "[":
            depth_bracket += 1
        elif c == "]" and depth_bracket > 0:
            depth_bracket -= 1
        elif depth_brace == 0 and depth_paren == 0 and depth_bracket == 0:
            if not in_handler and c == "=" and i + 1 < body_end and text[i + 1] == ">":
                spans.append((arm_start, i))
                in_handler = True
                j = i + 2
                while j < body_end and text[j] in (" ", "\t", "\r", "\n"):
                    j += 1
                handler_is_block = j < body_end and text[j] == "{"
                i = j
                continue
            if in_handler and not handler_is_block and c == ",":
                in_handler = False
                arm_start = i + 1
        i += 1
    return spans

def eval_cfg_when_not_test(expr):
    """Evaluate (can_be_true, can_be_false) for a Rust cfg(...) expression under test=False."""
    n = len(expr)
    pos = [0]

    def skip_ws():
        while pos[0] < n and expr[pos[0]].isspace():
            pos[0] += 1

    def parse_node():
        skip_ws()
        start = pos[0]
        while pos[0] < n and (expr[pos[0]].isalnum() or expr[pos[0]] == "_"):
            pos[0] += 1
        ident = expr[start:pos[0]]
        skip_ws()
        if pos[0] < n and expr[pos[0]] == "(":
            pos[0] += 1
            args = []
            while True:
                skip_ws()
                if pos[0] >= n:
                    break
                if expr[pos[0]] == ")":
                    pos[0] += 1
                    break
                args.append(parse_node())
                skip_ws()
                if pos[0] < n and expr[pos[0]] == ",":
                    pos[0] += 1
            if ident == "not":
                t, f = args[0] if len(args) == 1 else (True, True)
                return (f, t)
            if ident == "all":
                return (
                    all(t for t, _ in args),
                    any(f for _, f in args),
                )
            if ident == "any":
                return (
                    any(t for t, _ in args),
                    all(f for _, f in args),
                )
            return (True, True)
        if pos[0] < n and expr[pos[0]] == "=":
            pos[0] += 1
            while pos[0] < n and expr[pos[0]] not in (",", ")"):
                pos[0] += 1
            return (True, True)
        if not ident and pos[0] < n and expr[pos[0]] not in (",", ")"):
            pos[0] += 1
            return (True, True)
        if ident == "test":
            return (False, True)
        return (True, True)

    can_true, _ = parse_node()
    return can_true


def cfg_test_ranges(text):
    ranges = []
    for m in cfg_attr_open_re.finditer(text):
        cfg_end = balanced_end(text, m.end(), "(", ")")
        inner = text[m.end():cfg_end]
        if not has_test_re.search(inner) or eval_cfg_when_not_test(inner):
            continue
        close_bracket = text.find("]", cfg_end)
        if close_bracket == -1:
            continue
        semi = text.find(";", close_bracket + 1)
        brace = text.find("{", close_bracket + 1)
        if semi != -1 and (brace == -1 or semi < brace):
            ranges.append((m.start(), semi + 1))
        elif brace != -1:
            end = balanced_end(text, brace + 1, "{", "}")
            ranges.append((m.start(), end))
    return ranges

def structural_hits(rel, raw_text):
    text = scrub_rust_noncode(raw_text)
    hits = []
    in_api = rel.startswith("crates/rex-wave-api/")
    if not in_api:
        for m in matches_open_re.finditer(text):
            end = balanced_end(text, m.end(), "(", ")")
            if operator_pat_re.search(text, m.end(), end):
                hits.append((rel, line_of(text, m.start()), "matches!(.., Principal::Operator { .. })", OPERATOR_MATCH_MSG))
        for m in calendar_re.finditer(text):
            hits.append((rel, line_of(text, m.start()), m.group(1), CALENDAR_MSG))
    if rel != HTTP_GUARD_OWNER:
        for m in http_guard_fn_re.finditer(text):
            hits.append((rel, line_of(text, m.start()), "fn " + m.group(1), HTTP_GUARD_MSG))
    if rel != RUNTIME_DECIDE_CTX_OWNER:
        test_ranges = None
        for m in for_test_re.finditer(text):
            if test_ranges is None:
                test_ranges = cfg_test_ranges(text)
            pos = m.start()
            if not any(lo <= pos <= hi for lo, hi in test_ranges):
                hits.append((rel, line_of(text, pos), "DecideCtx::for_test(", FOR_TEST_MSG))
    for m in select_open_re.finditer(text):
        end = balanced_end(text, m.end(), "{", "}")
        for fut_start, fut_end in select_branch_future_spans(text, m.end(), end):
            for r in select_read_re.finditer(text, fut_start, fut_end):
                hits.append((rel, line_of(text, r.start()), r.group(1) + "(", SELECT_READ_MSG))
    for m in urandom_re.finditer(raw_text):
        hits.append((rel, line_of(raw_text, m.start()), "/dev/urandom", URANDOM_MSG))
    return hits

def has_digest(ns, token, table):
    key = (ns, token)
    h = digest_cache.get(key)
    if h is None:
        h = hashlib.sha256((ns + ":" + token).encode("utf-8")).hexdigest()[:16]
        digest_cache[key] = h
    return h in table

esc_re = re.compile(r"\\[tnr]")
mac_home_re = re.compile(r"(?<![A-Za-z0-9_])/" + "Users" + r"/[A-Za-z0-9._-]+")
sub_chunk_re = re.compile(r"[a-z0-9_:-]+")
sub_split_re = re.compile(r"([_:-])")
seat_chunk_re = re.compile(r"[a-z0-9_-]+")
word_token_re = re.compile(r"[a-z0-9]+")

def find_private_path_match(line):
    m_home = mac_home_re.search(line)
    if m_home is not None:
        return m_home.group(0)
    cleaned = esc_re.sub(" ", line.lower())
    for chunk in sub_chunk_re.findall(cleaned):
        if has_digest("subchunk", chunk, frozenset(["aa4964fa720aedd0"])):
            return chunk
        parts = sub_split_re.split(chunk)
        for i in range(0, len(parts), 2):
            p = parts[i]
            if not p:
                continue
            if has_digest("sub", p, PRIVATE_PATH_DIGESTS):
                return p
            if i + 2 < len(parts) and parts[i + 2]:
                pair = p + parts[i + 1] + parts[i + 2]
                if has_digest("sub", pair, PRIVATE_PATH_DIGESTS):
                    return pair
    return None

def find_private_seat_match(line_low):
    cleaned = esc_re.sub(" ", line_low)
    for chunk in seat_chunk_re.findall(cleaned):
        is_model_slug = chunk.startswith("gemini-") or chunk.startswith("orchestrator-")
        for w in word_token_re.findall(chunk):
            if has_digest("seat", w, PRIVATE_SEAT_DIGESTS):
                return w
            if not is_model_slug and has_digest("chunk", w, PRIVATE_STANDALONE_SEAT_DIGESTS):
                return w
        parts = chunk.split("-")
        n = len(parts)
        for i, p in enumerate(parts):
            if not p:
                continue
            if has_digest("seat", p, PRIVATE_SEAT_DIGESTS):
                return p
            if i + 1 < n and parts[i + 1]:
                pair = p + "-" + parts[i + 1]
                if has_digest("seat", pair, PRIVATE_SEAT_DIGESTS):
                    return pair
                if len(parts[i + 1]) >= 4 and has_digest(
                    "seatp4", p + "-" + parts[i + 1][:4], PRIVATE_SEAT_PREFIX4_DIGESTS
                ):
                    return pair
                if i + 2 < n and parts[i + 2]:
                    triple = pair + "-" + parts[i + 2]
                    if has_digest("seat", triple, PRIVATE_SEAT_DIGESTS):
                        return triple
    return None

def iter_entries():
    if git_rev:
        raw = subprocess.check_output(
            ["git", "-C", root, "ls-tree", "-r", "-z", git_rev]
        )
        blobs = []
        for rec in raw.split(b"\0"):
            if not rec:
                continue
            meta, path_b = rec.split(b"\t", 1)
            parts = meta.decode("ascii").split()
            obj_type = parts[1]
            obj_sha = parts[2]
            rel = path_b.decode("utf-8", errors="surrogateescape")
            if obj_type == "blob":
                blobs.append((rel, obj_sha))
            else:
                yield rel, b""
        if blobs:
            proc = subprocess.Popen(
                ["git", "-C", root, "cat-file", "--batch"],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
            )
            assert proc.stdin is not None and proc.stdout is not None
            for rel, sha in blobs:
                proc.stdin.write((sha + "\n").encode("ascii"))
                proc.stdin.flush()
                header = proc.stdout.readline().decode("ascii").strip().split()
                if len(header) < 3 or header[1] == "missing":
                    proc.stdin.close()
                    proc.wait()
                    sys.stderr.write("error: git cat-file missing blob {} ({})\n".format(sha, rel))
                    sys.exit(1)
                size = int(header[2])
                data = proc.stdout.read(size)
                proc.stdout.read(1)  # trailing LF
                yield rel, data
            proc.stdin.close()
            if proc.wait() != 0:
                sys.stderr.write("error: git cat-file --batch failed\n")
                sys.exit(1)
    else:
        raw = subprocess.check_output(
            ["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"]
        )
        seen = set()
        yielded_ancestors = set()
        o_dir = getattr(os, "O_DIRECTORY", 0)
        o_nofollow = getattr(os, "O_NOFOLLOW", 0)
        expected_walk_errnos = frozenset([
            errno.ENOENT,
            errno.ENOTDIR,
            errno.ELOOP,
            getattr(errno, "EMLINK", errno.ELOOP),
        ])
        root_fd = os.open(root, os.O_RDONLY | o_dir)
        try:
            for path_b in raw.split(b"\0"):
                if not path_b:
                    continue
                rel = path_b.decode("utf-8", errors="surrogateescape")
                if rel in seen:
                    continue
                seen.add(rel)
                segments = [seg for seg in rel.split("/") if seg]
                if not segments:
                    continue
                parent_fd = root_fd
                cur_rel = ""
                aborted = False
                try:
                    for seg in segments[:-1]:
                        cur_rel = seg if not cur_rel else (cur_rel + "/" + seg)
                        try:
                            next_fd = os.open(
                                seg, os.O_RDONLY | o_dir | o_nofollow, dir_fd=parent_fd
                            )
                        except OSError as exc:
                            if exc.errno not in expected_walk_errnos:
                                sys.stderr.write(
                                    "error: repo hygiene failed to open directory {}: {}\n".format(
                                        cur_rel, exc
                                    )
                                )
                                sys.exit(1)
                            try:
                                anc_st = os.lstat(seg, dir_fd=parent_fd)
                                if stat.S_ISLNK(anc_st.st_mode) and cur_rel not in yielded_ancestors:
                                    yielded_ancestors.add(cur_rel)
                                    yield cur_rel, os.readlink(seg, dir_fd=parent_fd).encode(
                                        "utf-8", errors="surrogateescape"
                                    )
                            except OSError as lstat_exc:
                                if lstat_exc.errno not in expected_walk_errnos:
                                    sys.stderr.write(
                                        "error: repo hygiene failed to stat {}: {}\n".format(
                                            cur_rel, lstat_exc
                                        )
                                    )
                                    sys.exit(1)
                            aborted = True
                            break
                        if parent_fd != root_fd:
                            os.close(parent_fd)
                        parent_fd = next_fd
                    if not aborted:
                        leaf = segments[-1]
                        try:
                            st = os.lstat(leaf, dir_fd=parent_fd)
                        except OSError as exc:
                            if exc.errno not in expected_walk_errnos:
                                sys.stderr.write(
                                    "error: repo hygiene failed to stat {}: {}\n".format(rel, exc)
                                )
                                sys.exit(1)
                            st = None
                        if st is not None:
                            if stat.S_ISLNK(st.st_mode):
                                target = os.readlink(leaf, dir_fd=parent_fd).encode(
                                    "utf-8", errors="surrogateescape"
                                )
                                yield rel, target
                            elif stat.S_ISREG(st.st_mode):
                                try:
                                    fd = os.open(
                                        leaf, os.O_RDONLY | o_nofollow, dir_fd=parent_fd
                                    )
                                except OSError as exc:
                                    if exc.errno not in expected_walk_errnos:
                                        sys.stderr.write(
                                            "error: repo hygiene failed to read {}: {}\n".format(
                                                rel, exc
                                            )
                                        )
                                        sys.exit(1)
                                    fd = None
                                if fd is not None:
                                    try:
                                        with os.fdopen(fd, "rb") as fh:
                                            data = fh.read()
                                    except Exception:
                                        os.close(fd)
                                        raise
                                    yield rel, data
                finally:
                    if parent_fd != root_fd:
                        os.close(parent_fd)
        finally:
            os.close(root_fd)

path_hits = []
seat_hits = []
todo_hits = []
struct_hits = []
licenses_nonempty = {"LICENSE-MIT": False, "LICENSE-APACHE": False}

for rel, data in iter_entries():
    if rel in licenses_nonempty and len(data.strip()) > 0:
        licenses_nonempty[rel] = True

    m_rel_path = find_private_path_match(rel)
    if m_rel_path is not None:
        path_hits.append((rel, 0, m_rel_path))
    m_rel_seat = find_private_seat_match(rel.lower())
    if m_rel_seat is not None:
        seat_hits.append((rel, 0, m_rel_seat))

    check_seats = rel not in LOCKFILES_SKIP_SEAT_WORDS
    check_todos = rel != "check"
    text = data.decode("utf-8", errors="replace")
    if src_rs_re.match(rel):
        struct_hits.extend(structural_hits(rel, text))
    for lineno, line in enumerate(text.splitlines(), 1):
        m_path = find_private_path_match(line)
        if m_path is not None:
            path_hits.append((rel, lineno, m_path))
        if check_seats:
            m_seat = find_private_seat_match(line.lower())
            if m_seat is not None:
                seat_hits.append((rel, lineno, m_seat))
        if check_todos and "TODO(PR-" in line:
            todo_hits.append((rel, lineno, line.strip()))

missing_lic = [k for k, ok in sorted(licenses_nonempty.items()) if not ok]
if missing_lic:
    for lic in missing_lic:
        sys.stderr.write("error: {} is missing or empty\n".format(lic))
    sys.exit(1)

total = len(path_hits) + len(seat_hits) + len(todo_hits) + len(struct_hits)
if total == 0:
    sys.exit(0)

MAX_PER_CAT = 25

def report(label, hits, msg):
    if not hits:
        return
    sys.stderr.write("\n[hygiene] {} ({} violation(s)):\n".format(label, len(hits)))
    for rel, lineno, detail in hits[:MAX_PER_CAT]:
        sys.stderr.write("  {}:{} ({}): {}\n".format(rel, lineno, detail, msg))
    if len(hits) > MAX_PER_CAT:
        sys.stderr.write(
            "  ... and {} more {} violation(s)\n".format(len(hits) - MAX_PER_CAT, label)
        )

report("private path/ID literals", path_hits, PATH_MSG)
report("private seat literals", seat_hits, SEAT_MSG)
report("stale PR TODOs", todo_hits, TODO_MSG)
if struct_hits:
    sys.stderr.write("\n[hygiene] structural lints ({} violation(s)):\n".format(len(struct_hits)))
    for rel, lineno, detail, msg in struct_hits[:MAX_PER_CAT]:
        sys.stderr.write("  {}:{} ({}): {}\n".format(rel, lineno, detail, msg))
    if len(struct_hits) > MAX_PER_CAT:
        sys.stderr.write("  ... and {} more structural violation(s)\n".format(len(struct_hits) - MAX_PER_CAT))
sys.stderr.write(
    "\nhygiene failed: {} violation(s) total ({} path/ID, {} seat, {} TODO, {} structural).\n".format(
        total, len(path_hits), len(seat_hits), len(todo_hits), len(struct_hits)
    )
)
sys.exit(1)
PY
