def make_isolated_env(idx, manifest_dir):
    run_dir = os.path.join(check_tmp, "run-{}".format(idx))
    tmp_dir = os.path.join(run_dir, "tmp")
    bb_dir = os.path.join(run_dir, "bb")
    state_dir = os.path.join(run_dir, "state")
    cfg_dir = os.path.join(run_dir, "cfg")
    prot_dir = os.path.join(cfg_dir, "rex-wave")
    for d in (tmp_dir, bb_dir, state_dir, prot_dir):
        os.makedirs(d, exist_ok=True)
    with open(os.path.join(prot_dir, "protected-roots"), "w", encoding="utf-8"):
        pass
    env = os.environ.copy()
    env["TMPDIR"] = tmp_dir
    env["BB_DATA_DIR"] = bb_dir
    env["XDG_STATE_HOME"] = state_dir
    env["XDG_CONFIG_HOME"] = cfg_dir
    env["CARGO_MANIFEST_DIR"] = manifest_dir
    env["CARGO_BIN_EXE_rex-wave"] = rex_wave_bin
    return env

passed_re = re.compile(r"test result: ok\. (\d+) passed; (\d+) failed; (\d+) ignored")

def run_test_bin(idx, label, exe, manifest_dir):
    env = make_isolated_env(idx, manifest_dir)
    t0 = time.monotonic()
    proc = subprocess.run(
        [exe],
        cwd=manifest_dir,
        env=env,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    dt = time.monotonic() - t0
    passed = 0
    ignored = 0
    for m in passed_re.finditer(proc.stdout):
        passed += int(m.group(1))
        ignored += int(m.group(3))
    return {
        "kind": "test",
        "label": label,
        "rc": proc.returncode,
        "dt": dt,
        "stdout": proc.stdout,
        "stderr": proc.stderr,
        "passed": passed,
        "ignored": ignored,
    }

